{
  "name": "klikindomaret-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Automation kategori Madu Klik Indomaret dengan Playwright dan TypeScript.",
  "scripts": {
    "test": "playwright test --project=guest",
    "test:headed": "playwright test --project=guest --headed",
    "auth": "playwright test --project=auth --headed",
    "test:session": "playwright test --project=session",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
